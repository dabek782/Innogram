model chats {
  id            String    @id @default(uuid()) @db.VarChar(36)
  name          String    @db.VarChar(36)
  description   String?
  type          type      @default(private)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  created_by_id String?   @db.VarChar(36)
  updated_at    DateTime
  updated_by_id String?   @db.VarChar(36)
  created_by    user?     @relation("ChatCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  updated_by    user?     @relation("ChatUpdatedBy", fields: [updated_by_id], references: [id], onDelete: Cascade)
  message       message[] @relation("ChatId")

  @@schema("chats")
}
