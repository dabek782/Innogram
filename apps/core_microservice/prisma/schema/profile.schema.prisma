model profile {
  id            String           @id @default(uuid()) @db.VarChar(36)
  user_id       String           @db.VarChar(36)
  username      String           @unique @db.VarChar(50)
  display_name  String           @db.VarChar(100)
  birthday      DateTime
  bio           String?
  avatar_url    String?          @db.VarChar(500)
  is_public     Boolean          @default(true)
  created_at    DateTime         @default(now())
  created_by_id String?          @db.VarChar(36)
  updated_at    DateTime
  updated_by_id String?          @db.VarChar(36)
  deleted       Boolean          @default(false)
  message       message[]        @relation("ProfileId")
  post          post[]           @relation("profileId")
  created_by    user?            @relation("ProfileCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  updated_by    user?            @relation("ProfileUpdatedBy", fields: [updated_by_id], references: [id], onDelete: Cascade)
  user          user             @relation("profileId", fields: [user_id], references: [id], onDelete: Cascade)
  followed      profile_follow[] @relation("followedId")
  follower      profile_follow[] @relation("followerId")
  chat_participants chat_participants[]
  post_like post_like[]
  comment_like comment_like[]
  profile_to_profile_configuration profile_to_profile_configuration[]
  @@schema("profile")
}
