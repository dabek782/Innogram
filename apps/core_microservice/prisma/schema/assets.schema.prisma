model assets {
  id            String         @id @default(uuid()) @db.VarChar(36)
  file_name     String         @db.VarChar(255)
  file_path     String         @db.VarChar(500)
  file_type     String         @db.VarChar(100)
  file_size     Int
  order_index   Int            @default(0)
  created_at    DateTime       @default(now())
  created_by_id String?        @db.VarChar(36)
  updated_at    DateTime       @updatedAt
  updated_by_id String?        @db.VarChar(36)
  created_by    user?          @relation("AssetsCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  updated_by    user?          @relation("AssetsUpdatedBy", fields: [updated_by_id], references: [id], onDelete: Cascade)
  posts_assets  posts_assets[]
  message_asset message_asset[]

  @@schema("assets")
}
