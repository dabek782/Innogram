model user {
  id                            String                  @id @default(uuid()) @db.VarChar(36)
  role                          role                    @default(user)
  disabled                      Boolean                 @default(false)
  created_at                    DateTime                @default(now())
  updated_at                    DateTime                @updatedAt
  updated_by_id                 String?                 @db.VarChar(36)
  created_by_id                 String?                 @db.VarChar(36)
  account_created_by            account[]               @relation("CreatedByuser")
  account_updated_by            account[]               @relation("UpdatedByuser")
  account_id                    account[]               @relation("accountId")
  asset_created_by              assets[]                @relation("AssetsCreatedBy")
  asset_updated_by              assets[]                @relation("AssetsUpdatedBy")
  audit_log_created             audit_log[]             @relation("auditLogCreated")
  audit_log_updated             audit_log[]             @relation("auditLogUpdated")
  audit_log_user_id             audit_log[]             @relation("userId")
  chat_created_by               chats[]                 @relation("ChatCreatedBy")
  chat_updated_by               chats[]                 @relation("ChatUpdatedBy")
  comment_created_by            comment[]               @relation("CommentCreatedBy")
  comment_updated_by            comment[]               @relation("CommentUpdatedBy")
  message_created_by            message[]               @relation("MessageCreatedBy")
  message_updated_by            message[]               @relation("MessageUpdatedBy")
  notification_created          notification[]          @relation("notificationCreated")
  notification_updated          notification[]          @relation("notificationUpdated")
  post_created_by               post[]                  @relation("PostCreatedBy")
  post_updated_by               post[]                  @relation("PostUpdatedBy")
  profile_created_by            profile[]               @relation("ProfileCreatedBy")
  profile_updated_by            profile[]               @relation("ProfileUpdatedBy")
  profile_id                    profile[]               @relation("profileId")
  profile_configuration_created profile_configuration[] @relation("profileConfigurationCreated")
  profile_configuration_updated profile_configuration[] @relation("profileConfigurationUpdated")
  created_by                    user?                   @relation("userCreates", fields: [created_by_id], references: [id], onDelete: Cascade)
  created_perfomed              user[]                  @relation("userCreates")
  updated_by                    user?                   @relation("userUpdates", fields: [updated_by_id], references: [id], onDelete: Cascade)
  updates_perfomed              user[]                  @relation("userUpdates")

  @@schema("user")
}
