model ProfileToProfileConfiguration {
  id                     String               @id @default(uuid())
  profileId              String
  profile                Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileConfigurationId String
  profileConfiguration   ProfileConfiguration @relation(fields: [profileConfigurationId], references: [id], onDelete: Cascade)
  createdBy              String
  createdByUser          User                 @relation("ProfileToProfileConfigurationCreated", fields: [createdBy], references: [id])
  updatedBy              String?
  updatedByUser          User?                @relation("ProfileToProfileConfigurationUpdated", fields: [updatedBy], references: [id])
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([profileId, profileConfigurationId])
}
