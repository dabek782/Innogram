model post {
  id            String         @id @default(uuid()) @db.VarChar(36)
  profile_id    String         @db.VarChar(36)
  content       String
  is_archived   Boolean        @default(false)
  created_at    DateTime       @default(now())
  created_by_id String?        @db.VarChar(36)
  updated_at    DateTime       @updatedAt
  updated_by_id String?        @db.VarChar(36)
  comment       comment[]
  created_by    user?          @relation("PostCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  profile       profile        @relation("profileId", fields: [profile_id], references: [id], onDelete: Cascade)
  updated_by    user?          @relation("PostUpdatedBy", fields: [updated_by_id], references: [id], onDelete: Cascade)
  post_asset_id posts_assets[]
  post_like post_like[]

  @@schema("post")
}
