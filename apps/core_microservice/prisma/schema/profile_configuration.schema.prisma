model ProfileConfiguration {
  id                      String                          @id @default(uuid())
  configKey               String
  isAdminAccessibleOnly   Boolean                         @default(false)
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  updatedById             String?
  createdById             String?
  createdBy               User?                           @relation("ProfileConfigurationCreated", fields: [createdById], references: [id])
  updatedBy               User?                           @relation("ProfileConfigurationUpdated", fields: [updatedById], references: [id])
  profileToConfigurations ProfileToProfileConfiguration[]
}
