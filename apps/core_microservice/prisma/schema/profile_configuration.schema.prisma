model profile_configuration {
  id                       String   @id @default(uuid())
  config_key               String   @db.VarChar(100)
  is_admin_accessible_only Boolean  @default(false)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
  updated_by               String?  @db.VarChar(36)
  created_by               String?  @db.VarChar(36)
  created_by_id            user?    @relation("profileConfigurationCreated", fields: [created_by], references: [id])
  updated_by_id            user?    @relation("profileConfigurationUpdated", fields: [updated_by], references: [id])
  profile_to_profile_configuration profile_to_profile_configuration[]
  @@schema("profile_configuration")
}
