model notification {
  id            String            @id @default(uuid()) @db.VarChar(36)
  type          notification_type
  title         String            @db.VarChar(255)
  message       String
  data          Json
  is_read       Boolean           @default(false)
  read_at       DateTime
  created_at    DateTime          @default(now())
  created_by_id String?           @db.VarChar(36)
  updated_at    DateTime
  updated_by_id String?           @db.VarChar(36)
  created_by    user?             @relation("notificationCreated", fields: [created_by_id], references: [id], onDelete: Cascade)
  updated_by    user?             @relation("notificationUpdated", fields: [updated_by_id], references: [id], onDelete: Cascade)

  @@schema("notification")
}
